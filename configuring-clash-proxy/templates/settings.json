    "nameservers": ["https://1.1.1.1/dns-query", "https://8.8.8.8/dns-query"],
    "extraFakeIpFilters": []
  },
  "tailscale": {
    "enabled": false,
    "acceptDns": true,
    "bypassTsNet": true
  }
