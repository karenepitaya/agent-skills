  "tun": {
    "enabled": true,
    "stack": "mips",
    "strictRoute": false
  },
  "systemProxy": {
    "enabled": true,
    "autoLaunch": true,
    "proxyGuard": true,
    "additionalBypass": []
  },
  "proxyGroups": {
