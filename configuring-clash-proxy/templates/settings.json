    "prependRules": [],
    "appendRules": []
  },
  "dns": {
    "enabled": true,
    "ipv6": true,
    "enhancedMode": "fake-ip",
    "fakeIpRange": "198.18.0.1/16",
    "fakeIpRange6": "2001:2::0/64",
    "defaultNameservers": ["223.5.5.5", "119.29.29.29"],
